DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/servia_db
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
CHAT_RETENTION_DAYS=30

# Backend ejecutándose directamente en la máquina local:
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_CHANNEL=servia:chat:events
REDIS_REQUIRED=false

# Opcional en local. ECS recibe estos valores desde Terraform.
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
S3_PRESIGNED_URL_TTL_SECONDS=3600
MAX_PUBLICATION_IMAGE_BYTES=12582912
SQL_ECHO=false

# En ECS con ElastiCache y TLS, reemplazar REDIS_URL por:
# REDIS_URL=rediss://your-cache-endpoint:6379/0
# REDIS_REQUIRED=true
