# Base de datos PostgreSQL contenerizada con Docker o Cloud
# Para Docker Compose local: postgresql+asyncpg://postgres:PasswordSegura123@db:5432/servia_db
# Para desarrollo en máquina local: postgresql+asyncpg://postgres:PasswordSegura123@localhost:5432/servia_db
# Para despliegue Cloud EC2: postgresql+asyncpg://postgres:PasswordSegura123@servia_db:5432/servia_db
DATABASE_URL=postgresql+asyncpg://postgres:PasswordSegura123@localhost:5432/servia_db

